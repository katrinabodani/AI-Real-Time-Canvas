# Server port (default 4000)
PORT=4000

# Web dev server uses this to find the socket server (default http://localhost:4000)
VITE_SERVER_URL=http://localhost:4000

# --- LLM (required) ---
# Generation uses an OpenAI-compatible LLM, so an API key is required.
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o
