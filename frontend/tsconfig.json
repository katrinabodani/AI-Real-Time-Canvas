{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "declaration": false,
    "types": ["vite/client"],
    "useDefineForClassFields": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
